{
  "name": "z360-virtual-tours",
  "version": "2.0.0",
  "description": "Professional 360° Virtual Tour Services - Real Estate, Business & More",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "dev:development": "next dev -p 4000",
    "dev:staging": "APP_ENV=staging next dev -p 4000",
    "dev:prod": "next dev -p 4000 --experimental-https",
    "build": "prisma generate && next build",
    "build:staging": "APP_ENV=staging prisma generate && next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.5.0",
    "clsx": "^2.1.0",
    "cookies-next": "^4.1.0",
    "framer-motion": "^10.17.9",
    "jose": "^5.2.0",
    "lucide-react": "^0.303.0",
    "next": "^14.0.4",
    "nodemailer": "^7.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.33",
    "prisma": "^5.7.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
