// Prisma Schema for Z360 Virtual Tours Business Platform
// MongoDB version

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Admin user for authentication
model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Regular user (customer) for authentication
model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String    @unique
  password          String
  name              String
  phone             String?
  company           String?
  avatar            String?   // User profile picture URL
  googleId          String?   @unique // Google OAuth ID
  authProvider      String    @default("email") // "email" or "google"
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  verifyToken       String?   // Email verification token
  verifyTokenExpiry DateTime? // Token expiry time
  resetToken        String?   // Password reset token
  resetTokenExpiry  DateTime? // Reset token expiry time
  bookings          Booking[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Tour categories (Real Estate, Business, Hospitality, etc.)
model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  // Icon name from lucide-react
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  tours       Tour[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Main tour entity
model Tour {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String    @unique
  description   String
  shortDesc     String?   // Short description for cards
  clientName    String?   // Client/business name
  location      String?
  coverImage    String   // Main thumbnail
  images        String?  // JSON array of additional images
  tourUrl       String?  // External 360 tour URL (e.g., from Kuula, Matterport)
  tourEmbed     String?  // Embed code for 360 viewer
  categoryId    String   @db.ObjectId
  category      Category @relation(fields: [categoryId], references: [id])
  premium       Boolean  @default(false)  // Premium tours shown first
  highlight     Boolean  @default(false)  // Highlighted tours shown second
  featured      Boolean  @default(false)
  isActive      Boolean  @default(true)
  views         Int      @default(0)
  completedAt   DateTime? // When the tour project was completed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Client testimonials
model Testimonial {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientName  String
  clientTitle String?  // e.g., "CEO at Company"
  clientImage String?
  content     String
  rating      Int      @default(5) // 1-5 stars
  tourId      String?  // Optional link to a specific tour
  featured    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pricing packages
model PricingPlan {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float
  priceLabel  String?   // e.g., "Starting at", "From"
  features    String    // JSON array of features
  isPopular   Boolean   @default(false)
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  // LemonSqueezy integration
  lemonSqueezyVariantId String?  // Product variant ID in LemonSqueezy
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

// Contact form submissions
model ContactSubmission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  company   String?
  service   String?  // Selected service type
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Site settings (about content, contact info, etc.)
model SiteSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ==========================================
// BOOKING & SCHEDULING SYSTEM
// ==========================================

// Urgency tiers with surcharge percentages
model UrgencyTier {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String    @unique  // "standard", "express", "rush"
  displayName       String              // "Standard Delivery", "Express", "Rush/Urgent"
  description       String?             // "7-14 day turnaround"
  minLeadDays       Int                 // Minimum days until scheduled date
  maxLeadDays       Int?                // Maximum days (null = unlimited)
  surchargePercent  Float     @default(0) // e.g., 0, 25, 50 for 0%, 25%, 50%
  isActive          Boolean   @default(true)
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
}

// Travel zones for distance-based pricing
model TravelZone {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String              // "Local", "Regional", "Extended"
  description       String?             // "Within 15km of base location"
  minDistanceKm     Float     @default(0)
  maxDistanceKm     Float?              // null = unlimited
  flatFee           Float?              // Fixed fee (e.g., 20 EUR)
  perKmRate         Float?              // Per-km rate (e.g., 0.50 EUR/km)
  isIncluded        Boolean   @default(false) // If true, no extra charge
  isActive          Boolean   @default(true)
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
}

// Travel bundles - group bookings for same city/date range
model TravelBundle {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String              // "Ohrid Bundle - January 2025"
  city              String              // Target city
  region            String?             // Region/area
  scheduledDate     DateTime            // When the photographer will be there
  startDate         DateTime?           // Start date of the bundle period
  endDate           DateTime?           // End date of the bundle period
  maxParticipants   Int       @default(10) // Maximum clients in bundle
  currentCount      Int       @default(0)  // Current participants
  distanceKm        Float?              // Distance from base
  totalTravelCost   Float?              // Total travel cost to split
  perPersonTravelFee Float?             // Calculated: totalTravelCost / participants
  discountPercent    Float     @default(0)  // Additional discount for bundle participants
  description        String?             // "Join our Ohrid trip and save on travel!"
  status             String    @default("open") // open, full, scheduled, completed, cancelled
  isActive           Boolean   @default(true)
  registrationDeadline DateTime?        // Last date to join
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  bookings           Booking[]
}

// Blocked dates (unavailable for booking)
model BlockedDate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime @unique
  reason      String?  // "Holiday", "Personal", "Fully Booked"
  isAllDay    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Main booking/quote request entity
model Booking {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId

  // External API integration (for bookings from BalkanEstateAI, etc.)
  externalId          String?      // ID from external system
  externalSource      String?      // Source app name (e.g., "BalkanEstateAI")

  // User relation (optional - for registered users)
  userId              String?      @db.ObjectId
  user                User?        @relation(fields: [userId], references: [id])

  // Client Info
  clientName          String
  clientEmail         String
  clientPhone         String?
  companyName         String?

  // Project Details
  propertyAddress     String              // Full address for travel calculation
  propertyCity        String?
  estimatedDistance   Float?              // Calculated distance in km
  serviceType         String?             // Category slug or name
  projectDescription  String?             // What client wants photographed
  specialRequests     String?             // Any special needs

  // Pricing Plan
  pricingPlanId       String?   @db.ObjectId
  pricingPlan         PricingPlan? @relation(fields: [pricingPlanId], references: [id])

  // Scheduling
  urgencyTierId       String?   @db.ObjectId
  urgencyTier         UrgencyTier? @relation(fields: [urgencyTierId], references: [id])
  preferredDate       DateTime?           // Client's preferred date
  preferredTime       String?             // Client's preferred time (e.g., "09:00", "14:00")
  alternateDate       DateTime?           // Backup date option
  alternateTime       String?             // Backup time option
  deadlineDate        DateTime?           // For urgent: must be done by this date
  confirmedDate       DateTime?           // Admin-confirmed date
  confirmedTime       String?             // Admin-confirmed time
  isFlexible          Boolean   @default(true)

  // Travel
  travelZoneId        String?   @db.ObjectId
  travelZone          TravelZone?  @relation(fields: [travelZoneId], references: [id])

  // Bundle (optional - if joining a bundle)
  travelBundleId      String?   @db.ObjectId
  travelBundle        TravelBundle? @relation(fields: [travelBundleId], references: [id])

  // Pricing (calculated quote)
  basePrice           Float?              // From PricingPlan
  urgencySurcharge    Float?              // Calculated surcharge amount
  travelFee           Float?              // Calculated travel fee (or bundle share)
  bundleDiscount      Float?              // Discount from bundle
  sameCityDiscount    Float?              // 15% discount when booking same city/date as existing job
  totalQuote          Float?              // Total estimated price
  depositAmount       Float?              // Required deposit
  depositPaid         Boolean   @default(false)

  // Payment tracking (LemonSqueezy)
  lemonSqueezyOrderId String?             // LemonSqueezy Order ID
  paymentStatus       String    @default("pending") // pending, paid, failed, refunded, partial
  paidAmount          Float?              // Amount actually paid
  paidAt              DateTime?           // When payment was received
  paymentMethod       String?             // lemonsqueezy, bank_transfer, cash, etc.
  balanceAmount       Float?              // Remaining balance after deposit
  balancePaidAt       DateTime?           // When balance was paid

  // Admin notes & Communication
  internalNotes       String?             // Admin-only notes
  communicationLog    String?             // JSON array of communication entries
  stageNotes          String?             // JSON object with notes per stage

  // Status Tracking
  status              String    @default("quote_requested")
  // Status values: quote_requested, quote_sent, negotiating, pending_deposit,
  //                confirmed, scheduled, in_progress, editing, delivered, completed, cancelled
  isRead              Boolean   @default(false)

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  quoteSentAt         DateTime?           // When quote was sent
  confirmedAt         DateTime?           // When client confirmed
  completedAt         DateTime?           // When project completed
  deliveredAt         DateTime?           // When final files were delivered

  // Work session tracking
  workStartedAt       DateTime?           // When work actually started
  workEndedAt         DateTime?           // When work actually ended
  workDurationMinutes Int?                // Total minutes worked

  // Deliverables tracking
  deliverables        String?             // JSON: files delivered, links, etc.
  clientFeedback      String?             // Client's feedback after delivery
  rating              Int?                // Client rating 1-5

  // Change Request (user can request changes, admin approves)
  changeRequestType     String?           // date_change, cancellation, other
  changeRequestMessage  String?           // User's message explaining the request
  changeRequestDate     DateTime?         // When the request was submitted
  requestedNewDate      DateTime?         // For date change requests
  requestedNewTime      String?           // For date change requests
  changeRequestStatus   String?           // pending, approved, rejected
}

// Booking settings (singleton-style config)
model BookingSettings {
  id                    String   @id @default("default") @map("_id")

  // Lead time defaults
  defaultMinLeadDays    Int      @default(3)
  maxAdvanceBookingDays Int      @default(90)

  // Business location (for distance calc)
  businessAddress       String?
  businessCity          String   @default("Skopje")
  businessLatitude      Float?
  businessLongitude     Float?

  // Travel settings
  includeReturnTrip     Boolean  @default(true)
  freeDistanceKm        Float    @default(15)

  // Working days
  workOnWeekends        Boolean  @default(false)
  workOnSunday          Boolean  @default(false)

  // Quote settings
  quoteValidDays        Int      @default(14)

  // Deposit settings
  requireDeposit        Boolean  @default(true)
  depositPercent        Float    @default(30)

  // Bundle settings
  minBundleParticipants Int      @default(3)  // Min to activate bundle pricing
  bundleDiscountPercent Float    @default(10) // Default bundle discount

  // Same-city discount settings
  sameCityDiscountPercent Float  @default(15) // Discount when booking where photographer is scheduled
  sameCityMaxDistanceKm   Float  @default(40) // Max distance to qualify for same-city discount

  updatedAt             DateTime @updatedAt
}

// ==========================================
// EXPENSE & FINANCIAL TRACKING
// ==========================================

// Expense categories
model ExpenseCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique  // "Travel", "Equipment", "Software", "Marketing", etc.
  description String?
  color       String?   // Hex color for charts
  icon        String?   // Icon name from lucide-react
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]
}

// Individual expense entries
model Expense {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  description String                    // What was the expense for
  amount      Float                     // Expense amount in EUR
  date        DateTime                  // Date of expense
  categoryId  String          @db.ObjectId
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  vendor      String?                   // Who was paid (supplier, vendor name)
  receiptUrl  String?                   // Link to receipt image/document
  notes       String?                   // Additional notes
  isRecurring Boolean         @default(false)
  recurringFrequency String?            // "weekly", "monthly", "yearly"
  bookingId   String?         @db.ObjectId  // Optional link to a booking (travel expense, etc.)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Financial reports/snapshots (for historical tracking)
model FinancialReport {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  reportType    String             // "weekly", "monthly", "yearly"
  periodStart   DateTime           // Start of reporting period
  periodEnd     DateTime           // End of reporting period
  totalIncome   Float              // Total income for the period
  totalExpenses Float              // Total expenses for the period
  netProfit     Float              // Income - Expenses
  bookingsCount Int                // Number of completed bookings
  avgBookingValue Float?           // Average booking value
  topCategory   String?            // Category with most income
  expensesByCategory String?       // JSON: {"Travel": 500, "Equipment": 200, ...}
  notes         String?            // Admin notes for the period
  createdAt     DateTime @default(now())
}

// ==========================================
// EXTERNAL API INTEGRATION
// ==========================================

// API Keys for external applications (like BalkanEstateAI)
model ApiKey {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String              // "BalkanEstateAI Production", "BalkanEstateAI Dev"
  key           String    @unique   // The actual API key (hashed)
  keyPrefix     String              // First 8 chars for identification (e.g., "z360_pk_")
  appName       String              // Application name
  appUrl        String?             // Application URL for CORS
  permissions   String    @default("read") // JSON array: ["read", "write", "bookings", "tours"]
  rateLimit     Int       @default(1000)   // Requests per hour
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  expiresAt     DateTime?           // Optional expiration
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  webhooks      Webhook[]
  apiLogs       ApiLog[]
}

// Webhooks for notifying external apps
model Webhook {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  apiKeyId      String    @db.ObjectId
  apiKey        ApiKey    @relation(fields: [apiKeyId], references: [id])
  url           String              // Webhook endpoint URL
  events        String              // JSON array: ["booking.created", "booking.completed", "tour.ready"]
  secret        String              // Secret for signing webhook payloads
  isActive      Boolean   @default(true)
  failureCount  Int       @default(0)
  lastTriggered DateTime?
  lastStatus    Int?                // Last HTTP status code
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// API request logs for monitoring and debugging
model ApiLog {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  apiKeyId      String?   @db.ObjectId
  apiKey        ApiKey?   @relation(fields: [apiKeyId], references: [id])
  method        String              // GET, POST, etc.
  endpoint      String              // /api/v1/bookings
  statusCode    Int
  requestBody   String?             // Truncated request body
  responseTime  Int                 // Response time in ms
  ipAddress     String?
  userAgent     String?
  error         String?             // Error message if any
  createdAt     DateTime  @default(now())
}
