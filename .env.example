# MongoDB Connection
# For local development: mongodb://localhost:27017/z360tours
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/z360tours
MONGODB_URI="mongodb://localhost:27017/z360tours"

# JWT Secret for Authentication (change in production)
JWT_SECRET="z360-virtual-tours-jwt-secret-2024-production-key"

# Email Configuration (for sending verification emails, password resets, etc.)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="Z360 Virtual Tours <noreply@z360tours.com>"

# Application URL (used for email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
