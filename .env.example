# Database (MongoDB)
# Use MongoDB Atlas (recommended - has replica set by default)
# Or configure local MongoDB as a replica set
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/z360virtualtours?retryWrites=true&w=majority"

# For local MongoDB with replica set:
# DATABASE_URL="mongodb://localhost:27017/z360virtualtours?replicaSet=rs0"

# JWT Secret for Admin Authentication (change in production)
JWT_SECRET="z360-virtual-tours-jwt-secret-2024-production-key"

# Admin credentials (used by seed script)
ADMIN_EMAIL="z360virtualtours@gmail.com"
ADMIN_PASSWORD="Z360Tours@2024!Secure"

# Google OAuth (for Google Sign-In)
# Get these from https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
